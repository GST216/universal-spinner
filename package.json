{
  "name": "universal-spinner",
  "version": "1.0.0",
  "description": "A lightweight, framework-agnostic SVG loading spinner for modern web applications.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/spinner.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "test": "vitest"
  },
  "keywords": [
    "spinner",
    "loading",
    "loader",
    "loading-spinner",
    "svg",
    "ui",
    "web",
    "framework-agnostic",
    "typescript"
  ],
  "author": "newbee55",
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}